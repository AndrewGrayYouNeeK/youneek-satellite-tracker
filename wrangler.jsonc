{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starlit-tracker",
  "account_id": "d74b0de637f4d9d9eb3efb9e13142784",
  "main": "worker/index.js",
  // Reviewed 2026-11-10. Dates before 2026-11-17 keep the current module
  // registry and request.signal defaults. This Worker uses fetch, the Cache
  // API, and the assets binding only — no Node built-ins.
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API routes run the Worker. Everything else is a static asset, with
    // unknown paths falling back to index.html for the SPA.
    "run_worker_first": ["/api/*"]
  }
}
